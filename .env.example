# Copy outside the source checkout. Never commit a configured copy.
# Linux/macOS: replace C:/... paths with absolute Unix paths; see docs/PLATFORMS.md.
EA_DATA_DIR=C:/AutopilotData/coordinator
EA_API_TOKEN=REPLACE_WITH_FIRST_GENERATED_TOKEN_AT_LEAST_32_CHARACTERS
EA_WORKER_TOKEN=REPLACE_WITH_SECOND_DIFFERENT_TOKEN_AT_LEAST_32_CHARACTERS
EA_OLLAMA_URL=http://127.0.0.1:11434
EA_LOCAL_MODEL=
EA_OPENAI_KEY=
EA_CLOUD_MODEL=
# Set CURRENT prices for your exact selected model, in USD per million tokens.
EA_INPUT_USD_PER_MILLION=0
EA_OUTPUT_USD_PER_MILLION=0
EA_CLOUD_OUTPUT_TOKENS=2048
EA_MAX_STEPS=2000
EA_ECONOMY_ENABLED=true
EA_ECONOMY_TEXT_LIMIT=2400
EA_ECONOMY_PLAN_TTL=120

# Worker-only settings: use a different env file INSIDE the dedicated VM.
# The worker needs the worker token, not the API token or OpenAI key.
EA_SERVER_URL=https://192.168.56.1:8766
EA_CA_FILE=C:/AutopilotData/worker/worker.pem
EA_ISOLATED_WORKER=false
EA_HEADLESS=false
EA_PROCESS_COMMANDS=["python","node","git","npm"]
